{
  "name": "lsflight",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "build": "tsc -b packages/sim tools/convert-dat",
    "typecheck": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "echo \"(FLT-003: eslint wiring pending)\" && true",
    "format": "echo \"(FLT-003: prettier wiring pending)\" && true",
    "check": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
